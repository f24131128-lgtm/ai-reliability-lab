{
  "mode": "demo",
  "dataset": {
    "day01": "data/demo/day01_questions.jsonl",
    "day02": "data/demo/day02_runs.csv",
    "day03": "data/demo/day03_results.csv",
    "day04": "data/demo/day04_format_cases.csv",
    "day05": "data/demo/day05_abstention_cases.csv",
    "day06": "data/demo/day06_risk_coverage.csv"
  },
  "day01_mock_outputs": {
    "Q001": "5",
    "Q002": "UNKNOWN",
    "Q003": "{\"status\":\"ok\"}"
  },
  "day02_prompt": "請回答同一個問題",
  "reliability_threshold": 0.8,
  "quality_gate": {
    "rules": [
      {"metric": "day04_format_pass_rate", "operator": ">=", "threshold": 1.0, "label": "format pass rate must be 100%"},
      {"metric": "day05_unsafe_answers", "operator": "<=", "threshold": 0, "label": "unsafe answers must be zero"}
    ]
  }
}
